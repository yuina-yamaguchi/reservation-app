# ローカル開発用の設定例です。.env にコピーして値を変更してください。

# ログインに使うパスワード（必須）
APP_PASSWORD=change-me

# Cookie署名用の秘密鍵（必須・長いランダム文字列）
SESSION_SECRET=change-me-to-a-long-random-string

# 本番（HTTPS）では true にしてください
COOKIE_SECURE=false

# セッションの有効期間（秒）
SESSION_MAX_AGE_SECONDS=2592000

# ローカルSQLiteの保存先（省略時は reservation_app.db）
DATABASE_PATH=./reservation_app.db

# Tursoを使う場合は以下を設定してください（DATABASE_PATHより優先）
# TURSO_DATABASE_URL=libsql://reservation-app-<your-org>.turso.io
# TURSO_AUTH_TOKEN=your-token
